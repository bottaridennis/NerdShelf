rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Every field the app is allowed to write on a library item.
    function allowedFields() {
      return [
        'userId', 'title', 'author', 'category', 'status', 'isWishlist',
        'seriesName', 'volumeNumber', 'volumeCount', 'totalVolumes',
        'genre', 'isbn', 'system', 'coverUrl',
        'loanedTo', 'loanDate',
        'description', 'notes', 'review', 'rating', 'tags',
        'totalPages', 'pagesRead', 'price',
        'createdAt', 'updatedAt'
      ];
    }

    function optString(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    function optInt(data, field, min, max) {
      return !(field in data) || (data[field] is int && data[field] >= min && data[field] <= max);
    }

    function optNumber(data, field, min, max) {
      return !(field in data) || (data[field] is number && data[field] >= min && data[field] <= max);
    }

    // Tags: at most 50, and the first ones (rules can't loop) must be short strings.
    function validTags(data) {
      return !('tags' in data) || (
        data.tags is list && data.tags.size() <= 50 &&
        (data.tags.size() < 1 || (data.tags[0] is string && data.tags[0].size() <= 60)) &&
        (data.tags.size() < 2 || (data.tags[1] is string && data.tags[1].size() <= 60)) &&
        (data.tags.size() < 3 || (data.tags[2] is string && data.tags[2].size() <= 60))
      );
    }

    // Field types and limits (shared by create and update).
    function isValidLibraryItem(data) {
      return data.keys().hasAll(['userId', 'title']) &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        (!('category' in data) || data.category in ['book', 'manga', 'gdr']) &&
        (!('status' in data) || data.status in ['unread', 'reading', 'read']) &&
        (!('isWishlist' in data) || data.isWishlist is bool) &&
        optString(data, 'author', 300) &&
        optString(data, 'seriesName', 300) &&
        optInt(data, 'volumeNumber', 1, 100000) &&
        optInt(data, 'volumeCount', 1, 1000) &&
        (!('totalVolumes' in data) || (data.totalVolumes is string && data.totalVolumes.size() <= 100) || data.totalVolumes is number) &&
        optString(data, 'genre', 200) &&
        optString(data, 'isbn', 50) &&
        optString(data, 'system', 200) &&
        optString(data, 'coverUrl', 5000) &&
        optString(data, 'loanedTo', 200) &&
        (!('loanDate' in data) || data.loanDate is timestamp || (data.loanDate is string && data.loanDate.size() <= 100)) &&
        optString(data, 'description', 10000) &&
        optString(data, 'notes', 10000) &&
        optString(data, 'review', 10000) &&
        optInt(data, 'rating', 1, 5) &&
        optInt(data, 'totalPages', 0, 100000) &&
        optInt(data, 'pagesRead', 0, 100000) &&
        optNumber(data, 'price', 0, 100000) &&
        validTags(data) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // ---------- Collections ----------

    match /test/{docId} {
      allow read: if isSignedIn();
    }

    match /libraryItems/{itemId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;

      // Queries must filter by userId == auth.uid
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Create: only known fields, server timestamp for createdAt.
      allow create: if isSignedIn() &&
        isValidId(itemId) &&
        incoming().keys().hasOnly(allowedFields()) &&
        incoming().createdAt == request.time &&
        isValidLibraryItem(incoming());

      // Update: owner only; only known fields may change (legacy unknown
      // fields that are left untouched are tolerated); createdAt and
      // ownership are immutable; updatedAt, when sent, is the server time.
      allow update: if isSignedIn() &&
        isValidId(itemId) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(allowedFields()) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['userId', 'createdAt']) &&
        (!('updatedAt' in incoming().diff(existing()).affectedKeys()) || incoming().updatedAt == request.time) &&
        isValidLibraryItem(incoming());

      allow delete: if isSignedIn() &&
        isValidId(itemId) &&
        existing().userId == request.auth.uid;
    }
  }
}
